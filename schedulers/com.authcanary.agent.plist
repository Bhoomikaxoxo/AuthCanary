<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.authcanary.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>AUTHCANARY_DIR_PLACEHOLDER/.venv/bin/python</string>
        <string>AUTHCANARY_DIR_PLACEHOLDER/main.py</string>
        <string>--config</string>
        <string>AUTHCANARY_DIR_PLACEHOLDER/config.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>AUTHCANARY_DIR_PLACEHOLDER</string>

    <!-- Run every 15 minutes -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>AUTHCANARY_DIR_PLACEHOLDER/authcanary.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>AUTHCANARY_DIR_PLACEHOLDER/authcanary.stderr.log</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart automatically if it exits with a failure code -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
