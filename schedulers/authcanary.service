[Unit]
Description=AuthCanary — Auth log anomaly detection
After=network.target

[Service]
Type=oneshot
# Use the project's venv Python, not the system Python
ExecStart=%h/authcanary/.venv/bin/python %h/authcanary/main.py --config %h/authcanary/config.yaml
WorkingDirectory=%h/authcanary
StandardOutput=journal
StandardError=journal
# Restart on non-zero exit (parse/ingestion errors)
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=default.target
