[Unit]
Description=SentinelLog — Auth log anomaly detection
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/sentinellog/main.py --config %h/sentinellog/config.yaml
WorkingDirectory=%h/sentinellog
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
